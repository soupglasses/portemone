# Create once: install -m 600 .env.example .env
# Fill in .env locally; mise loads it automatically.
# Release signing configuration: DEVELOPMENT.md, "Releases".
ANDROID_HOME="$HOME/Android/Sdk"
ANDROID_KEYSTORE_BASE64=''
ANDROID_KEYSTORE_PASSWORD=''
ANDROID_KEY_ALIAS='portemone'
# For the documented PKCS12 key, use the same password as the keystore.
ANDROID_KEY_PASSWORD=''
