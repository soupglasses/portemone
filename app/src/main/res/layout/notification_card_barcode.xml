<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/card_face"
        android:layout_width="match_parent"
        android:layout_height="204dp"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/notification_card_background"
        android:clipToOutline="true"
        android:layerType="hardware"
        android:forceHasOverlappingRendering="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/brand_gradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/brand_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/brand_logo"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/scan_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/barcode"
                android:contentDescription="@string/membership_code"
                android:layout_width="300dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:scaleType="center" />

            <TextView
                android:id="@+id/card_number"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:textColor="#4B5563"
                android:fontFamily="sans-serif"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textDirection="ltr"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
