<!-- The framework background ID lets the widget host apply its own corner treatment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingVertical="12dp"
    android:background="@drawable/card_widget_background">

    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"
        android:paddingHorizontal="20dp" android:includeFontPadding="false"
        android:text="@string/card_widget_name" android:textColor="#146C64"
        android:textSize="16sp" android:textStyle="bold" />

    <FrameLayout android:id="@+id/widget_scan_area"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:background="#FFFFFF">
        <ImageView android:id="@+id/widget_code"
            android:contentDescription="@string/membership_code"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="center" />
        <TextView android:id="@+id/widget_message"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="8dp"
            android:text="@string/card_widget_preview"
            android:textColor="#222222" android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
